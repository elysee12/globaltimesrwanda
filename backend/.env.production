# Production Environment Configuration for Global Times Rwanda Backend

# Database Configuration
DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3306/global_times_rwanda"

# JWT Configuration
JWT_SECRET="change-this-to-a-very-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3000

# IMPORTANT: Both should be your production domain (no trailing slash)
# Since the backend serves /news/:slug directly for OG tag generation,
# BACKEND_URL and FRONTEND_URL should both be your public domain.
FRONTEND_URL="https://globaltimesrwanda.com,https://www.globaltimesrwanda.com"
BACKEND_URL="https://globaltimesrwanda.com"

# Site Name (used in social previews)
SITE_NAME="Global Times Rwanda"

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=robertbjournal@gmail.com
EMAIL_PASS=jriy txwy kdkc irqr
CONTACT_TO_EMAIL=robertbjournal@gmail.com
